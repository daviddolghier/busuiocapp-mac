{
  "name": "Busuioc-App",
  "version": "1.0.13",
  "description": "Busuioc App desktop application",
  "author": "David",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.busuioc.app",
    "productName": "Busuioc App",
    "afterPack": "./removeLocales.js",

    "directories": {
      "output": "dist"
    },

    "publish": {
      "provider": "github",
      "owner": "daviddolghier",
      "repo": "busuiocapp",
      "releaseType": "draft"
    },

    "files": [
      "**/*",
      "!dist/**"
    ],

    "win": {
      "icon": "installer/logo.ico",
      "artifactName": "BusuiocApp-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },

    "mac": {
      "category": "public.app-category.utilities",
      "artifactName": "BusuiocApp-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },

    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Busuioc App",
      "runAfterFinish": true,
      "perMachine": true,
      "include": "installer/customHeader.nsh",
      "installerIcon": "installer/logo.ico",
      "uninstallerIcon": "installer/logo.ico"
    }
  },

  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },

  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}