{
  "name": "Busuioc-App",
  "version": "1.0.21",
  "description": "Busuioc App desktop application",
  "author": "David Dolghier",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },

  "build": {
    "appId": "com.busuioc.app",
    "productName": "Busuioc App",
    "afterPack": "./removeLocales.js",

    "directories": {
      "output": "dist"
    },

    "publish": {
      "provider": "github",
      "owner": "daviddolghier",
      "repo": "busuiocapp-mac",
      "releaseType": "draft"
    },

    "files": [
      "**/*",
      "!dist/**"
    ],

    "fileAssociations": [
      {
        "ext": "mp3",
        "name": "MP3 Audio File",
        "description": "MP3 audio file",
        "icon": "installer/MP3.icns"
      },
      {
        "ext": "wav",
        "name": "WAV Audio File",
        "description": "WAV audio file",
        "icon": "installer/WAV.icns"
      },
      {
        "ext": "ogg",
        "name": "OGG Audio File",
        "description": "OGG audio file",
        "icon": "installer/OGG.icns"
      }
    ],

    "mac": {
      "icon": "installer/logo.icns",
      "category": "public.app-category.utilities",
      "artifactName": "BusuiocApp-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    }
  },

  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "^26.15.3"
  },

  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
